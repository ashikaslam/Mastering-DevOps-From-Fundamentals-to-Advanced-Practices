# =============================================================================
# LOCAL DEVELOPMENT — copy this file to .env and adjust as needed
# =============================================================================

# Django Core
SECRET_KEY=django-insecure-local-dev-key-change-in-production
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# Database
# Leave DB_ENGINE unset (or set to django.db.backends.sqlite3) for local dev.
# Switch to postgresql on EC2.
DB_ENGINE=django.db.backends.sqlite3

# --- PostgreSQL (only needed when DB_ENGINE=django.db.backends.postgresql) ---
# DB_NAME=django_db
# DB_USER=django_user
# DB_PASSWORD=strongpassword
# DB_HOST=localhost
# DB_PORT=5432
